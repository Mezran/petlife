# Copy to .env and adjust as needed. Each variable is read and validated against apps/api/src/config.ts to validate before server boots. 


# NODE_ENV=development | test | production   (optional — defaults to development)
NODE_ENV=development

# PORT=any integer, no default. 
PORT=3000 

# LOG_LEVEL=fatal | error | warn | info | debug | trace | silent
# Optional: defaults based on NODE_ENV
LOG_LEVEL=debug

# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>
# Must match the Postgres container's credentials — the root .env's
DATABASE_URL=postgresql://petlife:changeme@localhost:5432/petlife

## BETTER_AUTH_SECRET=32+ character random string. 
# Can utilize: openssl rand -base64 32
BETTER_AUTH_SECRET=ChangeMe

# BETTER_AUTH_URL=the server's own public origin — BetterAuth derives cookie
# security and trusted origins from it.
# Optional: defaults to http://localhost:<PORT>; set it when that stops being
# true (production, behind the proxy).
# BETTER_AUTH_URL=http://localhost:3000
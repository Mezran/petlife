{
  "info": {
    "name": "PetLife — auth flows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exercises 5.2's Done-when end to end: register -> login sets the cookie -> session endpoint returns the user -> logout kills it. Run order matters; the cookie jar carries the session between requests. Newman-provable: npx newman run src/api/auth/tests/auth.postman_collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "hunter2hunter2"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique per run — duplicate-registration is its own test below",
                  "pm.collectionVariables.set('email', `collection+${Date.now()}@petlife.dev`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the created user', () => {",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.user.id).to.be.a('string');",
                  "});",
                  "pm.test('session cookie set (HttpOnly rides in the jar)', () => {",
                  "  pm.expect(pm.cookies.has('better-auth.session_token')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-up", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Collection User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Session lifecycle",
      "item": [
        {
          "name": "Get session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('session + user for the cookie holder', () => {",
                  "  pm.expect(body.session.token).to.be.a('string');",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/get-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "get-session"]
            }
          }
        },
        {
          "name": "Sign out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => {",
                  "  pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-out"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Get session after sign-out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('session is gone — body is null', () => {",
                  "  pm.expect(pm.response.text()).to.eql('null');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/get-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "get-session"]
            }
          }
        },
        {
          "name": "Sign back in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('fresh session token', () => {",
                  "  pm.expect(pm.response.json().token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Failure cases",
      "item": [
        {
          "name": "Duplicate registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 — the registration flow leaks account existence (accepted in the auth decisions note)', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().code).to.eql('USER_ALREADY_EXISTS_USE_ANOTHER_EMAIL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-up", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Collection User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with the generic message', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_EMAIL_OR_PASSWORD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-not-it\"\n}"
            }
          }
        },
        {
          "name": "Unknown email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 — identical to wrong-password, login does not enumerate', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_EMAIL_OR_PASSWORD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@petlife.dev\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Short password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 — minPasswordLength default (8) enforced', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('PASSWORD_TOO_SHORT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "1.7 CSRF check: credentialed unsafe requests must carry a trusted Origin"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-up", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shorty\",\n  \"email\": \"shorty@petlife.dev\",\n  \"password\": \"short\"\n}"
            }
          }
        }
      ]
    }
  ]
}
